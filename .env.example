# ---- HTTP ----
WALLET_HTTP_ADDR=:8080
WALLET_SHUTDOWN_GRACE=20s
WALLET_LOG_LEVEL=info

# ---- PostgreSQL ----
WALLET_DB_DSN=postgres://wallet:wallet@localhost:5433/wallet?sslmode=disable
WALLET_DB_MAX_CONNS=20
WALLET_MIGRATE_ON_START=true

# ---- SQS (LocalStack local, AWS em produção) ----
WALLET_SQS_ENDPOINT=http://localhost:4566
WALLET_SQS_REGION=us-east-1
WALLET_SQS_ACCESS_KEY_ID=test
WALLET_SQS_SECRET_KEY=test
WALLET_SQS_REQUEST_QUEUE=wager-transactions.fifo
WALLET_SQS_EVENTS_QUEUE=integration-events.fifo
WALLET_SQS_DLQ_QUEUE=wager-transactions-dlq.fifo
WALLET_SQS_WAIT_SECONDS=5
WALLET_SQS_MAX_MESSAGES=10
WALLET_SQS_VISIBILITY=60
WALLET_SQS_MAX_RECEIVE=5

# ---- Workers ----
WALLET_WORKERS_ENABLED=true
WALLET_CONSUMER_CONCURRENCY=4
WALLET_OUTBOX_INTERVAL=500ms
WALLET_OUTBOX_BATCH=100
WALLET_OUTBOX_LEASE=30s
WALLET_REFERENCE_INTERVAL=1s
WALLET_REFERENCE_BATCH=50
WALLET_REFERENCE_MAX_ATTEMPTS=10
WALLET_REFERENCE_TTL=15m

# ---- Auth (Keycloak / OIDC) ----
WALLET_AUTH_ISSUER=http://localhost:8080/realms/wallet
# opcional: override do endpoint de JWKS (ex.: host interno do Docker)
WALLET_AUTH_JWKS_URL=
# opcional: valida aud; vazio desativa
WALLET_AUTH_AUDIENCE=

# ---- Diversos ----
WALLET_LEDGER_PAGE_MAX=200

# ---- Observabilidade (OpenTelemetry) ----
# Desligado por padrão: o serviço sobe sem Collector e as métricas Prometheus
# em /metrics continuam funcionando. Ligue junto com o profile "observability":
#   docker compose --profile observability up
WALLET_OTEL_ENABLED=false
WALLET_OTEL_ENDPOINT=localhost:4317
WALLET_OTEL_INSECURE=true
WALLET_OTEL_SERVICE_NAME=wallet
# Identifica a réplica nos traces (3 instâncias = 3 valores distintos).
WALLET_INSTANCE_ID=wallet-1
WALLET_ENV=local
# 1.0 = amostra tudo; 0.1 = 10% (útil sob carga alta).
WALLET_OTEL_SAMPLE_RATIO=1.0
# Espelha os logs JSON no Collector (Loki) além do stdout.
WALLET_OTEL_LOGS_ENABLED=true
WALLET_OTEL_EXPORT_TIMEOUT=5s
WALLET_OTEL_BATCH_TIMEOUT=2s
WALLET_OTEL_MAX_QUEUE_SIZE=4096

# Ajuste do profile "observability" no docker-compose (host visto pelo host):
# Grafana     http://localhost:3000   (anônimo, já com os dashboards)
# Prometheus  http://localhost:9090
# Tempo       http://localhost:3200
# Collector   localhost:4317 (OTLP gRPC)
