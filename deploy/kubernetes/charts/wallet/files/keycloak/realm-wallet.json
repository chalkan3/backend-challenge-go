{
  "realm": "wallet",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "eventsListeners": ["jboss-logging"],

  "clientScopes": [
    {
      "name": "wallet:provider",
      "description": "Machine identity of a game provider. Grants wager submission and read of its own transactions.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "wallet:internal",
      "description": "Internal wallet service identity: the only scope allowed to open wallets and read the ledger.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "wallet:audience",
      "description": "Injects the wallet API audience (aud=wallet-api) into access tokens, so a token minted for another audience in this realm is refused by the service.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "wallet-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "wallet-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    }
  ],

  "clients": [
    {
      "clientId": "provider-a",
      "name": "Game provider A",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "provider-a-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["wallet:provider", "wallet:audience"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "providerId",
            "claim.value": "provider-a",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "provider-b",
      "name": "Game provider B",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "provider-b-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["wallet:provider", "wallet:audience"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "providerId",
            "claim.value": "provider-b",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "wallet-internal",
      "name": "Internal wallet service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "internal-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["wallet:internal", "wallet:audience"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "internal-role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "wallet:internal",
            "claim.value": "true",
            "jsonType.label": "boolean",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}
