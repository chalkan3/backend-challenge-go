{
  "realm": "wallet",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "clients": [
    {
      "clientId": "provider-a",
      "name": "Game provider A",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "provider-a-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "providerId",
            "claim.value": "provider-a",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "provider-b",
      "name": "Game provider B",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "provider-b-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "providerId",
            "claim.value": "provider-b",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "wallet-internal",
      "name": "Internal wallet service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "internal-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "internal-role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "wallet:internal",
            "claim.value": "true",
            "jsonType.label": "boolean",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}
